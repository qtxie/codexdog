{
  "name": "codex-provider-supervisor",
  "version": "0.1.0",
  "description": "Supervise Codex turns and resume provider-related failures after recovery.",
  "type": "module",
  "private": true,
  "files": [
    "dist",
    "scripts",
    "README.md"
  ],
  "bin": {
    "codex-supervisor": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "canary": "npm run build && node scripts/protocol-smoke.mjs --canary",
    "check": "tsc -p tsconfig.json --noEmit",
    "smoke": "npm run build && node scripts/protocol-smoke.mjs",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
